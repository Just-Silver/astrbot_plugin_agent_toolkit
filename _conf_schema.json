{
  "enabled": {
    "description": "注册 web_fetch 工具",
    "type": "bool",
    "default": true
  },
  "max_chars": {
    "description": "单次返回的字符上限",
    "type": "int",
    "default": 8000,
    "slider": {
      "min": 1000,
      "max": 50000,
      "step": 1000
    },
    "hint": "超出后会在末尾提示用 start 参数继续读取。"
  },
  "timeout": {
    "description": "单次请求超时（秒）",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 5,
      "max": 120,
      "step": 5
    }
  },
  "blocked_hosts": {
    "description": "额外禁止访问的域名",
    "type": "list",
    "default": [],
    "hint": "填写域名即可，子域同样生效；端口会被忽略。"
  }
}
